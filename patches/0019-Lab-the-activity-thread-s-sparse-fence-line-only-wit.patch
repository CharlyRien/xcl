From c33651e2a07732084be2ebf7b924506fd733d974 Mon Sep 17 00:00:00 2001
From: CharlyRien <9572419+CharlyRien@users.noreply.github.com>
Date: Fri, 27 Nov 2026 11:56:38 +0100
Subject: [PATCH 19/23] Lab: the activity thread's sparse fence line only with
 XCL_CALL_STATS (review F7)

host.rs wrote a "sparse fence:" line every 2 s and tried the sparse
lock for it without any switch, so a run with every lab switch off did
not log (nor lock) as the base did. The line now comes only with
XCL_CALL_STATS (sparse::fence_line_if), which every lab run of ours
sets. The scatter's counters in the "sparse windows" line and the
sparse fence bookkeeping stay (log text and atomics only).

Test: fence_line_if(false) gives none, fence_line_if(true) the line.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/xcl/src/hle/d3d12x/sparse.rs | 15 +++++++++++++++
 crates/xcl/src/host.rs              |  5 ++++-
 2 files changed, 19 insertions(+), 1 deletion(-)

diff --git a/crates/xcl/src/hle/d3d12x/sparse.rs b/crates/xcl/src/hle/d3d12x/sparse.rs
index 61acdecc..2caeb4e5 100644
--- a/crates/xcl/src/hle/d3d12x/sparse.rs
+++ b/crates/xcl/src/hle/d3d12x/sparse.rs
@@ -362,6 +362,12 @@ static FENCE_OBJ: Mutex<Option<ID3D12Fence>> = Mutex::new(None);
 static FENCE_SIGNALLED: AtomicU64 = AtomicU64::new(0);
 static CPU_WAITING_FOR: AtomicU64 = AtomicU64::new(0);
 
+/// `fence_line` for the activity thread, only when `on` (`XCL_CALL_STATS`; review F7): without it the
+/// activity thread neither writes the line nor tries the sparse lock, as before the line existed.
+pub fn fence_line_if(on: bool) -> Option<String> {
+    on.then(fence_line)
+}
+
 /// A line on the sparse queue's progress that never waits for a lock: its fence (reached /
 /// signalled), a CPU wait under the state's lock in progress, whether that lock is held now.
 pub fn fence_line() -> String {
@@ -5125,4 +5131,13 @@ mod tests {
             assert_ne!(VirtualFree(base as *mut c_void, 0, MEM_RELEASE), 0);
         }
     }
+
+    /// Review F7: the activity thread's sparse fence line (and its try of the sparse lock) only with
+    /// `XCL_CALL_STATS`; without it, none.
+    #[test]
+    fn the_fence_line_is_written_only_with_call_stats() {
+        let _serial = lab_test_lock();
+        assert!(fence_line_if(false).is_none(), "off: no line, no lock tried");
+        assert!(fence_line_if(true).is_some_and(|l| l.starts_with("sparse fence: ")), "on: the line");
+    }
 }
diff --git a/crates/xcl/src/host.rs b/crates/xcl/src/host.rs
index df862644..709b4125 100644
--- a/crates/xcl/src/host.rs
+++ b/crates/xcl/src/host.rs
@@ -80,7 +80,10 @@ pub fn host_main(boot_path: &Path) -> i32 {
                     d[0], d[1], d[2], d[3], d[4], d[5], d[6], d[7], d[8], d[9], d[10]
                 );
                 // (lab, never waits for a lock: what a stuck sparse queue or lock would show)
-                crate::xlog_info!("{}", crate::hle::d3d12x::sparse::fence_line());
+                // (lab: only with XCL_CALL_STATS, so a run without it logs and locks as the base did)
+                if let Some(line) = crate::hle::d3d12x::sparse::fence_line_if(crate::hle::d3d12x::call_stats::on()) {
+                    crate::xlog_info!("{line}");
+                }
                 // where the memory is: the process's commit, video memory, and XCL's parts of it
                 let private = unsafe {
                     use windows_sys::Win32::System::ProcessStatus::{K32GetProcessMemoryInfo, PROCESS_MEMORY_COUNTERS_EX};
-- 
