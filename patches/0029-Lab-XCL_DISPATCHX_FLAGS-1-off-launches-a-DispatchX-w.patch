+/// lab `XCL_DISPATCHX_FLAGS`: the console's group shape (`numthreads`) of the console CS of a
+/// translated compute pipeline (after PR #2610's `pso_threads`, KDenKC, GPL-3.0-or-later)
+static PSO_THREADS: Mutex<Option<HashMap<usize, [u32; 3]>>> = Mutex::new(None);
+
+/// The console's group shape of a translated compute pipeline (None: not known).
+pub fn pso_threads(pso: usize) -> Option<[u32; 3]> {
+    let pso = super::pso_async::resolve(pso);
+    PSO_THREADS.lock().unwrap().as_ref()?.get(&pso).copied()
+}
+
+fn note_pso_threads(pso: usize, cs: &[u8]) {
+    if let Some(t) = crate::gpu::recomp::pso::compute_threads(cs) {
+        PSO_THREADS.lock().unwrap().get_or_insert_with(HashMap::new).insert(pso, t);
+    }
+}
