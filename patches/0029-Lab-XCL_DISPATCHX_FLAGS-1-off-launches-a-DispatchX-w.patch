 /// #14 Dispatch: with a translated pipeline, on XCL's ABI with the kept root arguments
 pub(super) unsafe extern "system" fn dispatch(this: *mut c_void, x: u32, y: u32, z: u32) {
+    dispatch_flags(this, x, y, z, 0);
+}
+
+/// lab `XCL_DISPATCHX_FLAGS=1` (off by default): `DispatchX` passes its flags on. Port of the host
+/// side of PR #2610 (KDenKC, GPL-3.0-or-later, `dispatch_groups`); the masking of the lanes past
+/// the count (#3015) needs the translator and is not here: the last group runs whole.
+pub(super) fn dispatchx_flags_on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| {
+        let on = std::env::var("XCL_DISPATCHX_FLAGS").is_ok_and(|v| v.trim() == "1");
+        if on {
+            crate::xlog_info!("lab XCL_DISPATCHX_FLAGS=1: a DispatchX with thread dimensions (flag 0x20) launches whole groups of the program's numthreads (the last group runs whole)");
+        }
+        on
+    })
+}
+
+/// `DispatchX` flag `USE_THREAD_DIMENSIONS` (bit 5 of the dispatch initiator): x, y, z are thread
+/// counts; the console launches whole groups and leaves the lanes past the count out of EXEC.
+/// (0x8000 is the wave32 bit: nothing to do here.)
+const DISPATCH_THREAD_DIMENSIONS: u32 = 0x20;
+
+/// The groups a dispatch of `dims` with `flags` launches on a program of group shape `threads`
+/// (None: thread dimensions with a group shape not known - not launched).
+pub(super) fn dispatch_groups(threads: Option<[u32; 3]>, dims: [u32; 3], flags: u32) -> Option<[u32; 3]> {
+    if flags & DISPATCH_THREAD_DIMENSIONS == 0 {
+        return Some(dims);
+    }
+    let t = threads?.map(|t| t.max(1));
+    Some(std::array::from_fn(|k| dims[k].div_ceil(t[k])))
+}
+
+/// `Dispatch` / `DispatchX(x, y, z, flags)` (flags 0 unless `XCL_DISPATCHX_FLAGS=1`).
+pub(super) unsafe fn dispatch_flags(this: *mut c_void, x: u32, y: u32, z: u32, flags: u32) {
     super::targets::note_dispatch();
     let pso = with(this, |s| s.pso);
     // lab XCL_RT_WATCH: the record of a watched pipeline (None when off)
@@ -2071,7 +2105,7 @@ pub(super) unsafe extern "system" fn dispatch(this: *mut c_void, x: u32, y: u32,
