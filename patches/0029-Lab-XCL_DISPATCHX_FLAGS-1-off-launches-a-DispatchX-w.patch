-    if super::pso_async::is_pending(pso) && super::list_x::defer(this, super::list_x::Deferred::Dispatch(x, y, z)) {
+    if super::pso_async::is_pending(pso) && super::list_x::defer(this, super::list_x::Deferred::Dispatch(x, y, z, flags)) {
         super::rt_watch::seen(watched, super::rt_watch::Outcome::PutOff);
         return super::pso_async::need_by_submit(pso);
     }
@@ -2088,6 +2122,31 @@ pub(super) unsafe extern "system" fn dispatch(this: *mut c_void, x: u32, y: u32,
         count(DISPATCHES_SKIPPED);
         return;
     }
+    // (the group shape only looked up for thread dimensions: no lock on the plain path)
+    let threads = if flags & DISPATCH_THREAD_DIMENSIONS != 0 { super::real::pso_threads(pso) } else { None };
+    let Some([x, y, z]) = dispatch_groups(threads, [x, y, z], flags) else {
+        static N: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
