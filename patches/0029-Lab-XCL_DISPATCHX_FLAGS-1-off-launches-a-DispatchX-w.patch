+        let first = {
+            let mut g = SEEN.lock().unwrap();
+            !g.contains(&flags) && {
+                g.push(flags);
+                true
+            }
+        };
+        if first {
+            crate::xlog_info!("lab XCL_DISPATCHX_FLAGS=1: DispatchX with flags {flags:#x} on {pso:#x}: launched as {x}x{y}x{z} groups of {threads:?}");
+        }
+    }
     match translated_dispatch(this, list, pso, x, y, z) {
         Ok(()) => {
             count(DISPATCHES);
@@ -3048,6 +3107,25 @@ mod tests {
     use super::*;
     use std::sync::atomic::AtomicUsize;
 
+    /// lab XCL_DISPATCHX_FLAGS: a `DispatchX` with thread dimensions (0x20) launches whole groups of
+    /// the program's numthreads; without the flag the counts are groups (cases of PR #2610's test,
+    /// KDenKC, GPL-3.0-or-later, and of VIctory#2750's controls).
+    #[test]
+    fn dispatch_x_thread_dimensions_become_whole_groups() {
+        let g64 = Some([64, 1, 1]);
+        assert_eq!(dispatch_groups(g64, [640, 1, 1], 0x20), Some([10, 1, 1]), "a whole last group");
+        assert_eq!(dispatch_groups(g64, [100, 1, 1], 0x20), Some([2, 1, 1]), "a cut-short last group runs whole");
+        assert_eq!(dispatch_groups(g64, [45, 1, 1], 0x20), Some([1, 1, 1]), "the title's 45 threads: one group, not 45");
+        assert_eq!(dispatch_groups(Some([32, 1, 1]), [82_606, 1, 1], 0x8020), Some([2_582, 1, 1]), "the wave32 bit changes nothing; under 65,535 groups");
+        assert_eq!(dispatch_groups(Some([8, 8, 1]), [20, 16, 3], 0x20), Some([3, 2, 3]));
+        assert_eq!(dispatch_groups(g64, [7, 2, 1], 0), Some([7, 2, 1]), "Dispatch: groups as they are");
+        assert_eq!(dispatch_groups(g64, [7, 2, 1], 0x8000), Some([7, 2, 1]), "the wave32 bit alone: groups");
+        assert_eq!(dispatch_groups(g64, [0, 1, 1], 0x20), Some([0, 1, 1]), "no threads, no groups");
+        assert_eq!(dispatch_groups(None, [100, 1, 1], 0x20), None, "thread dimensions, group shape not known: not launched");
+        assert_eq!(dispatch_groups(None, [100, 1, 1], 0), Some([100, 1, 1]));
+        assert_eq!(dispatch_groups(Some([0, 1, 1]), [5, 1, 1], 0x20), Some([5, 1, 1]), "a zero axis counts as 1");
+    }
