                 crate::xlog_info!(
                     "D3D12.X: view memory: no source for tile {tile:#x} of {va:#x}+{len:#x}: page mapping {:x?}, CPU view {:x?}, physical page here {}",
@@ -499,12 +538,16 @@ unsafe fn ensure_range(va: usize, len: usize, far: usize, old: usize, root: bool
         }
